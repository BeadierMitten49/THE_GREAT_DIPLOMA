      +get_by_packaging(packaging_id): list[PackagingStock]
      +arrival(packaging_id, quantity, comment): int
      +write_off(stock_id, amount): void
    }

    class ProductStockService {
      -_repo: ProductStockRepository
      -_reservation_repo: ProductReservationRepository
      -_task_repo: ProductionTaskRepository
      -_completion_repo: TaskCompletionRepository
      -_product_repo: ProductRepository
      --
      +get(id): ProductStock
      +get_all(): list[ProductStock]
