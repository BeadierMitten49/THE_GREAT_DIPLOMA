    abstract class "IRepository<T>" as IRepository {
      {abstract} +get_by_id(id: int): T | None
      {abstract} +save(entity: T): int
    }
    abstract class "ISoftDeleteRepository<T>" as ISoftDeleteRepository {
      {abstract} +get_all(include_inactive: bool): list[T]
    }
    abstract class "IPlainRepository<T>" as IPlainRepository {
      {abstract} +get_all(): list[T]
    }
    IRepository <|-- ISoftDeleteRepository
    IRepository <|-- IPlainRepository
  }

