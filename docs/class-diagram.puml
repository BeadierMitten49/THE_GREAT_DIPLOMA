      +get_reserved(stock_id): Decimal
      +arrival(...): int
      +write_off(stock_id, amount): void
      +adjust(stock_id, quantity, comment): void
    }

    class PackagingStockService {
      -_repo: PackagingStockRepository
      --
      +get(id): PackagingStock
