    class RawMaterialService {
      -_repo: RawMaterialCatalogRepository
      --
      +get(id): RawMaterialCatalog
      +get_all(include_inactive): list[RawMaterialCatalog]
      +create(name, unit, shelf_life_days, critical_stock, comment): int
      +update(id, ...): void
      +deactivate(id): void
      +activate(id): void
    }

    class PackagingService {
      -_repo: PackagingCatalogRepository
      --
      +get(id): PackagingCatalog
      +get_all(include_inactive): list[PackagingCatalog]
      +create(name, unit, critical_stock, comment): int
      +update(id, ...): void
      +deactivate(id): void
      +activate(id): void
    }

    class RawMaterialStockService {
      -_repo: RawMaterialStockRepository
      -_reservation_repo: RawMaterialReservationRepository
      --
      +get(id): RawMaterialStock
      +get_all(): list[RawMaterialStock]
