      +get_reserved(stock_id): tuple[int, list[int]]
      +arrival(...): int
      +adjust(stock_id, quantity, comment): void
      +get_pending_acceptances(): list[dict]
      +accept_from_task(task_id): int
      +write_off(stock_id, amount): void
    }
